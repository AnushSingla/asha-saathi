# =============================================================================
# Asha Saathi — Client Environment Variables
# =============================================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value below.
#   3. NEVER commit your .env file — it is listed in .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------

# Base URL of the Express backend. Use http://localhost:5000 for local dev.
# In production, replace with your deployed server URL (e.g. https://api.example.com).
VITE_BACKEND_URL=http://localhost:5000


# -----------------------------------------------------------------------------
# Firebase — Web App Configuration
# -----------------------------------------------------------------------------
# Obtain these values from the Firebase Console:
#   https://console.firebase.google.com
#   → Your Project → Project Settings → General → Your apps → SDK setup and configuration
#
# All six keys are required. If any are missing, Firebase will not initialise
# and authentication features (email/password, Google Sign-In) will be disabled.
# -----------------------------------------------------------------------------

# Web API key for the Firebase project.
VITE_FIREBASE_API_KEY=

# Firebase Authentication domain (usually <project-id>.firebaseapp.com).
VITE_FIREBASE_AUTH_DOMAIN=

# Unique identifier for your Firebase project.
VITE_FIREBASE_PROJECT_ID=

# Cloud Storage bucket URL (usually <project-id>.appspot.com).
VITE_FIREBASE_STORAGE_BUCKET=

# Sender ID used by Firebase Cloud Messaging.
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Unique identifier for this specific Firebase web app.
VITE_FIREBASE_APP_ID=
