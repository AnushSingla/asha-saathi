# =============================================================================
# Asha Saathi — Server Environment Variables
# =============================================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value below.
#   3. NEVER commit your .env file — it is listed in .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# MongoDB connection string.
# Local example:  mongodb://localhost:27017/asha-saathi
# Atlas example:  mongodb+srv://<user>:<password>@cluster0.mongodb.net/<dbname>
MONGO_URL=


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# Secret key used to sign and verify JWT tokens.
# Use a long, random string (e.g. 64+ characters). Keep this private.
JWT_SECRET=

# Secret key required to register or log in as an admin.
# Choose a strong passphrase and share it only with trusted administrators.
ADMIN_SECRET=


# -----------------------------------------------------------------------------
# Firebase — Service Account (Server-side)
# -----------------------------------------------------------------------------
# Used to verify Firebase ID tokens sent from the client (Google Sign-In, etc.).
#
# How to obtain:
#   Firebase Console → Project Settings → Service Accounts
#   → Generate new private key → download JSON file.
#
# Paste the ENTIRE JSON object as a single-line string, e.g.:
#   FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", ...}
FIREBASE_SERVICE_ACCOUNT_KEY=


# -----------------------------------------------------------------------------
# AI / External APIs
# -----------------------------------------------------------------------------

# API key for Groq (LLM inference used by the Asha chat feature).
# Obtain from: https://console.groq.com → API Keys
GROQ_KEY=
